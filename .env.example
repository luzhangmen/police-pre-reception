LLM_PROVIDER=moonshot
LLM_API_KEY=
LLM_MODEL=kimi-k2.6
LLM_BASE_URL=https://api.moonshot.cn/v1

# Map / geocoding — 国内推荐高德（https://lbs.amap.com/）
MAP_GEOCODING_ENABLED=true
# 学校全称，显著提升「一食堂、图书馆」等校内地点识别，例如：华东师范大学
MAP_DEFAULT_REGION=
# 高德 Web 服务 Key（地理编码，后端使用）
AMAP_API_KEY=
# 高德 JS API Key（地图展示，可与上面相同；需开通「Web端 JS API」）
AMAP_WEB_KEY=
# 可选：高德 city 参数，默认使用 MAP_DEFAULT_REGION
MAP_AMAP_CITY=
MAP_NEARBY_RADIUS_METERS=250
# 境外或备用：Google Geocoding（国内不推荐作为主方案）
GOOGLE_MAPS_API_KEY=
